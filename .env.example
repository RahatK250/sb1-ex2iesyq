# Office 365 / Azure AD Configuration
# Get these values from your Azure AD app registration

# Azure AD Application (Client) ID
VITE_AZURE_CLIENT_ID=your_client_id_here

# Redirect URI after successful login (must match Azure AD app registration)
VITE_REDIRECT_URI=http://localhost:5173

# Redirect URI after logout
VITE_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# Supabase Configuration (existing)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
